# Local Convex CLI deployment selection; convex dev supplies the real value.
CONVEX_DEPLOYMENT=

# Set the following in the Convex dashboard or with `convex env set`.
# They must exist in the DEPLOYMENT environment, not only this local file.
CLERK_JWT_ISSUER_DOMAIN=https://your-instance.clerk.accounts.dev
# Exact Clerk user subject IDs, comma separated; never an email or client role.
ADMIN_CLERK_SUBJECTS=user_primary_admin,user_second_reviewer
# Optional. Without a key, hosted payment initialization fails closed.
PAYSTACK_SECRET_KEY=
# Optional HTTPS application redirect; it is NOT settlement confirmation.
PAYSTACK_CALLBACK_URL=
V4_API_URL=
V4_VERIFICATION_API_KEY=
V4_VERIFICATION_API_SECRET=
V4_WALLET_WEBHOOK_SECRET=

# Required for signup verification and password reset emails. Use a verified Resend sending domain.
SITE_URL=https://your-passenger-app.example.com
RESEND_API_KEY=
AUTH_EMAIL_FROM=you@your-domain.com

# Register this URL in Paystack (replace with your Convex HTTP deployment URL):
# https://YOUR_DEPLOYMENT.convex.site/paystack/webhook
# Do not send webhook requests to the client .convex.cloud URL.

# Parcel maps: configure on the Convex deployment, never in a client env file.
MAPBOX_ACCESS_TOKEN=

# Required for phone OTP, receiver delivery codes, and parcel status SMS.
TERMII_API_KEY=
TERMII_SENDER_ID=Passenger
# generic or dnd, according to your approved Termii route.
TERMII_CHANNEL=generic
# Use the base URL shown in your Termii dashboard.
TERMII_BASE_URL=https://api.ng.termii.com

# Required for BVN/NIN verification. Keep both credentials on the Convex
# deployment only; never expose them through an EXPO_PUBLIC_ variable.
V4_VERIFICATION_API_KEY=dd7464ace9e62d62d560d9be6cc3d034fe4d97dc0d05a498
V4_VERIFICATION_API_SECRET=d988ec79af283c622cea7a30d9e1fe30680bd96376cee5586f4c214b0899fe5a
# Local provider during development. A cloud Convex deployment requires a
# publicly reachable HTTPS provider URL instead of 127.0.0.1.
V4_VERIFICATION_API_URL=https://baya.lemu.africa/api/v4/verifications

# The banking routes share the v4 credentials. V4_API_URL may be omitted when
# V4_VERIFICATION_API_URL ends in /verifications; Passenger derives the v4 root.
V4_API_URL=https://baya.lemu.africa/api/v4
# Required to encrypt verified payout account numbers before storing them.
# Use an independent random value of at least 32 characters and keep it stable.
V4_BANK_ACCOUNT_ENCRYPTION_KEY=

# Face matching uses bundled TensorFlow.js and face-api in a Convex Node Action.
# Model weights are loaded from a pinned jsDelivr URL. No paid model API key is needed.
