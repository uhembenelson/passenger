# Local Convex CLI deployment selection; convex dev supplies the real value.
CONVEX_DEPLOYMENT=

# Set the following in the Convex dashboard or with `convex env set`.
# They must exist in the DEPLOYMENT environment, not only this local file.
CLERK_JWT_ISSUER_DOMAIN=https://your-instance.clerk.accounts.dev
# Exact Clerk user subject IDs, comma separated; never an email or client role.
ADMIN_CLERK_SUBJECTS=user_primary_admin,user_second_reviewer
# Optional. Without a key, hosted payment initialization fails closed.
PAYSTACK_SECRET_KEY=
# Optional HTTPS application redirect; it is NOT settlement confirmation.
PAYSTACK_CALLBACK_URL=

# Optional. Required to email password reset codes.
RESEND_API_KEY=
AUTH_EMAIL_FROM=you@your-domain.com

# Register this URL in Paystack (replace with your Convex HTTP deployment URL):
# https://YOUR_DEPLOYMENT.convex.site/paystack/webhook
# Do not send webhook requests to the client .convex.cloud URL.

# Parcel maps: configure on the Convex deployment, never in a client env file.
MAPBOX_ACCESS_TOKEN=
